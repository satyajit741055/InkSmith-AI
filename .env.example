# OpenAI
OPENAI_API_KEY=sk-...
GROQ_API_KEY=
# Tavily (for research)
TAVILY_API_KEY=tvly-...

# Google Gemini (for image generation)
GOOGLE_API_KEY=...



POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=blog_agent_db
# PostgreSQL
DATABASE_URL=postgresql+asyncpg://<blog_user>:<blog_pass>@localhost:5432/blog_agent_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Portkey LLM Gateway
PORTKEY_API_KEY=pk-...
PORTKEY_PRIMARY_CONFIG_ID=pc-...

# Logfire Observability
LOGFIRE_TOKEN=pylf_v2_...

# LangSmith Agent Tracing (optional)
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=blog-writing-agent

# App
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173