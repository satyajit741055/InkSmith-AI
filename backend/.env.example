# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=blog_db
POSTGRES_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/blog_db
POSTGRES_URL_SYNC=postgresql+psycopg2://postgres:yourpassword@localhost:5432/blog_db
CHECKPOINTER_DB_URI=postgresql://postgres:yourpassword@localhost:5432/blog_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
SECRET_KEY=your-secret-key-min-32-characters-long-for-security
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM API Keys
OPENAI_API_KEY=sk-your-openai-api-key-here
GROQ_API_KEY=gsk-your-groq-api-key-here
HF_API_KEY=hf_your-huggingface-api-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# Output Configuration
OUTPUT_DIR=blogs
IMAGE_OUT_DIR=blogs/images

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8001

# API Configuration (backend URL for frontend)
API_BASE_URL=http://localhost:8001/api/v1

# Storage Backend
BACKEND=local

# Environment
ENVIRONMENT=local
